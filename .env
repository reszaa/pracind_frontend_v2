# ==============================================================================
# 1. FRONTEND ENVIRONMENT (Vue 3 / Vite)
# Letakkan di root folder frontend. Variabel harus diawali dengan VITE_
# ==============================================================================
VITE_APP_NAME="Pracindo ERP"
VITE_APP_ENV=development
# URL dasar yang akan dipanggil oleh @/utils/api.js
VITE_API_BASE_URL=http://localhost:8000/api/


# ==============================================================================
# 2. BACKEND APP CORE (Python)
# Letakkan di root folder backend.
# ==============================================================================
APP_ENV=development
SECRET_KEY=masukkan-kunci-rahasia-sepanjang-50-karakter-di-sini
DEBUG=True
# Pisahkan dengan koma untuk multi-host (contoh: localhost,127.0.0.1,api.domain.com)
ALLOWED_HOSTS=localhost,127.0.0.1


# ==============================================================================
# 3. DATABASE CONNECTION (PostgreSQL)
# Semua transaksi, master stock, dan logistik akan bermuara langsung ke sini
# ==============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pracindo_erp
DB_USER=postgres
DB_PASSWORD=masukkan_password_database
DB_HOST=127.0.0.1
DB_PORT=5432


# ==============================================================================
# 4. JWT AUTHENTICATION (/auth/token/ & /me/)
# Konfigurasi token untuk keamanan akses Staff User
# ==============================================================================
# Bisa disamakan dengan SECRET_KEY atau menggunakan kunci khusus
JWT_SECRET_KEY=kunci-rahasia-khusus-jwt
# Durasi token aktif (dalam menit)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440


# ==============================================================================
# 5. CLOUD STORAGE (/upload/)
# Kredensial untuk endpoint penyimpanan lampiran faktur ke awan (contoh: AWS S3)
# ==============================================================================
USE_CLOUD_STORAGE=True
AWS_ACCESS_KEY_ID=kunci_akses_s3_anda
AWS_SECRET_ACCESS_KEY=rahasia_akses_s3_anda
AWS_STORAGE_BUCKET_NAME=pracindo-dokumen
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com


# ==============================================================================
# 6. LOGGING & DEBUGGING
# Berguna untuk melacak error pada trigger SQL atau eksekusi fungsi stok
# ==============================================================================
LOG_LEVEL=DEBUG
LOG_FILE_PATH=/var/log/pracindo_api.log